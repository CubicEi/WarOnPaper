{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarOnPaper",
  "version": "0.1.0",
  "identifier": "com.waronpaper.desktop",
  "build": {
    "frontendDist": "../runtime/manager/client/dist",
    "devUrl": "http://127.0.0.1:4358",
    "beforeDevCommand": "npm run stage",
    "beforeBuildCommand": "npm run stage"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../runtime/"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
