{
  "name": "@wop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/room.js",
  "types": "./dist/room.d.ts",
  "exports": {
    ".": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    },
    "./room": {
      "types": "./dist/room.d.ts",
      "import": "./dist/room.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@wop/shared": "*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
